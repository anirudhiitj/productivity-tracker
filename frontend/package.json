{
  "name": "focusrank",
  "version": "1.0.0",
  "type": "module",
  "main": "public/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder -w --publish never"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "terser": "^5.46.0",
    "vite": "^5.0.0",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.focusrank.tracker",
    "productName": "FocusRank",
    "copyright": "Copyright 2026",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "buildResources": "public",
      "output": "dist_electron"
    },
    "files": [
      "package.json",
      {
        "from": "dist",
        "to": "dist"
      },
      "public/main.js",
      "public/preload.js",
      "public/icon.png"
    ],
    "extraResources": [
      {
        "from": "../dist/tracker-backend",
        "to": "python-backend",
        "filter": ["**/*"]
      },
      {
        "from": "../data",
        "to": "data",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.png",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.png",
      "category": "Utility",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FocusRank",
      "runAfterFinish": true
    }
  }
}
